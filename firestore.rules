rules_version = '2';

// ============================================================
// MusiBot - Reglas de Firestore
// Filosofía: el front público (MusiBot) SOLO puede ESCRIBIR (crear/actualizar).
// La lectura la hace ÚNICAMENTE el panel MusiBot Lector con usuario autenticado
// (Firebase Auth). Nadie puede borrar desde el cliente.
//
// Cómo aplicar:
//   Firebase Console -> Firestore Database -> pestaña "Reglas" -> pegar esto -> Publicar.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Sesiones (snapshot del lead) ---
    match /sessions/{sessionId} {
      // MusiBot (público) crea/actualiza. Sin borrado desde el cliente.
      allow create, update: if request.resource.data.session_id is string
                            && request.resource.data.session_id.size() < 100;
      // MusiBot Lector puede leer si el usuario está autenticado.
      allow read:   if request.auth != null;
      allow delete: if false;

      // --- Eventos de comportamiento (clics, mensajes, nodos...) ---
      match /events/{eventId} {
        allow create: if request.resource.data.type is string
                      && request.resource.data.type.size() < 60;
        // MusiBot Lector puede leer eventos si está autenticado.
        allow read:          if request.auth != null;
        allow update, delete: if false;
      }
    }

    // --- Preguntas sin respuesta (para mejorar el kb) ---
    match /knowledge_gaps/{gapId} {
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() < 1200;
      // MusiBot Lector puede leer y marcar como revisada (update) si está autenticado.
      allow read, update: if request.auth != null;
      allow delete:       if false;
    }

    // --- Registro de exportaciones para IA (solo panel autenticado) ---
    match /ai_exports/{exportId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Todo lo demás: prohibido.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
